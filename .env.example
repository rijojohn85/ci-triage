# .env.example — variable names only. Never put real values here; secrets live in .env (git-ignored).
# Key scopes per AD-16 (sample config stays secret-free).

# GitHub App private key: gateway + orchestrator only
GITHUB_APP_PRIVATE_KEY=

# GitHub webhook signature secret: gateway (+ orchestrator webhook forwarding) only
GITHUB_WEBHOOK_SECRET=

# GitHub App identifiers: gateway (+ orchestrator) only
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Anthropic API key: three Claude agents (analyzer, proposer, reviewer) + orchestrator only
ANTHROPIC_API_KEY=

# Jev (Typesafe System One) is reached through OpenRouter with typesafe-sdk.
# TYPESAFE_API_KEY holds your OpenRouter API key: jev agent + orchestrator only.
TYPESAFE_API_KEY=
# Non-secret. Base URL the SDK calls (it appends /v1/systemone). Compose defaults
# it to https://openrouter.ai/api; set it in .env for scripts/evals run outside Compose.
TYPESAFE_BASE_URL=

# Postgres connection string: gateway/orchestrator + workflow persistence only (never spoke agents)
DATABASE_URL=

# Worker name used in a run's lease (story 1.2). Non-secret; a random suffix is
# added to every claim, so this only labels the worker. Defaults apply when empty.
WORKER_ID=

# Postgres container settings (compose; values live in .env only, never committed)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=

# Deployment environment tag (dev/graded): non-secret
TRIAGE_ENV=

# Gateway knobs (story 1.1): host port published by Compose, and the listen
# host/port inside the container. Defaults apply when left empty.
GATEWAY_HOST_PORT=
GATEWAY_HOST=
GATEWAY_PORT=
