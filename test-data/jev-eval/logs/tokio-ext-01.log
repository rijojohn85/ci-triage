2026-09-09T17:51:23.9879647Z bail() {
2026-09-09T17:51:23.9879954Z   printf '::error::install-action: %s\n' "$*"
2026-09-09T17:51:23.9880303Z   exit 1
2026-09-09T17:51:23.9880652Z }
2026-09-09T17:51:23.9881027Z # If /bin/sh is dash, environment variable containing % is not imported, but is fine
2026-09-09T17:51:23.9881542Z # because it also means that it will not be exposed to subprocess.
2026-09-09T17:51:23.9881960Z if /usr/bin/env | grep -Eq '^BASH_FUNC_'; then
2026-09-09T17:51:23.9882477Z   bail 'bash function injection via BASH_FUNC_ environment variable is not allowed for security reasons'
2026-09-09T17:51:23.9883331Z fi
2026-09-09T17:51:23.9883633Z if ! command -v bash >/dev/null; then
2026-09-09T17:51:23.9884056Z   if grep -Eq '^ID=alpine' /etc/os-release; then
2026-09-09T17:51:23.9884499Z     printf '::group::Install packages required for install-action (bash)\n'
2026-09-09T17:51:23.9884937Z     # NB: sync with apk_install in main.sh
2026-09-09T17:51:23.9885292Z     if command -v sudo >/dev/null; then
2026-09-09T17:51:23.9885618Z       sudo apk --no-cache add bash
2026-09-09T17:51:23.9885941Z     elif command -v doas >/dev/null; then
2026-09-09T17:51:23.9886276Z       doas apk --no-cache add bash
2026-09-09T17:51:23.9886606Z     else
2026-09-09T17:51:23.9886885Z       apk --no-cache add bash
2026-09-09T17:51:23.9887270Z     fi
2026-09-09T17:51:23.9887536Z     printf '::endgroup::\n'
2026-09-09T17:51:23.9887849Z   else
2026-09-09T17:51:23.9888120Z     bail 'this action requires bash'
2026-09-09T17:51:23.9888430Z   fi
2026-09-09T17:51:23.9888667Z fi
