2026-09-23T11:10:18.4392864Z ##[group]Run # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-23T11:10:18.4393478Z # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-23T11:10:18.4394205Z # cache restore, so update-alternatives symlinks (eg the one libblas
2026-09-23T11:10:18.4394719Z # creates at /usr/lib/<multiarch>/libblas.so.3) are never produced.
2026-09-23T11:10:18.4395212Z # Add every /usr/lib/<multiarch> subdirectory that holds shared
2026-09-23T11:10:18.4395709Z # libraries to the ldconfig search path so the dynamic linker still
2026-09-23T11:10:18.4396435Z # finds them.  Use dpkg-architecture to derive the host's multiarch
2026-09-23T11:10:18.4396896Z # tuple so this works on non-x86_64 runners too.
2026-09-23T11:10:18.4397337Z multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
2026-09-23T11:10:18.4397809Z find "/usr/lib/${multiarch}" -mindepth 2 -maxdepth 2 \
2026-09-23T11:10:18.4398213Z   -name '*.so.*' -printf '%h\n' \
2026-09-23T11:10:18.4398522Z   | sort -u \
2026-09-23T11:10:18.4398893Z   | sudo tee /etc/ld.so.conf.d/zzz-cache-apt-extras.conf > /dev/null
2026-09-23T11:10:18.4399291Z sudo ldconfig
2026-09-23T11:10:18.4466632Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
