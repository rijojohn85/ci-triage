2026-09-26T18:53:28.8416583Z ##[start-action display=Refresh dynamic linker cache;id=__self.__run_2]
2026-09-26T18:53:28.8514485Z ##[group]Run # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-26T18:53:28.8515186Z # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-26T18:53:28.8515813Z # cache restore, so update-alternatives symlinks (eg the one libblas
2026-09-26T18:53:28.8516433Z # creates at /usr/lib/<multiarch>/libblas.so.3) are never produced.
2026-09-26T18:53:28.8516997Z # Add every /usr/lib/<multiarch> subdirectory that holds shared
2026-09-26T18:53:28.8517566Z # libraries to the ldconfig search path so the dynamic linker still
2026-09-26T18:53:28.8518184Z # finds them.  Use dpkg-architecture to derive the host's multiarch
2026-09-26T18:53:28.8518717Z # tuple so this works on non-x86_64 runners too.
2026-09-26T18:53:28.8519219Z multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
2026-09-26T18:53:28.8519738Z find "/usr/lib/${multiarch}" -mindepth 2 -maxdepth 2 \
2026-09-26T18:53:28.8520185Z   -name '*.so.*' -printf '%h\n' \
2026-09-26T18:53:28.8520568Z   | sort -u \
2026-09-26T18:53:28.8520970Z   | sudo tee /etc/ld.so.conf.d/zzz-cache-apt-extras.conf > /dev/null
2026-09-26T18:53:28.8521588Z sudo ldconfig
2026-09-26T18:53:28.8548114Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
