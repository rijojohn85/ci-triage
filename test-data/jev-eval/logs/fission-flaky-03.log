2026-08-10T06:15:24.1197768Z ##[group]Run # Capture heap + goroutine profiles from the long-lived control-plane
2026-08-10T06:15:24.1198403Z # Capture heap + goroutine profiles from the long-lived control-plane
2026-08-10T06:15:24.1198811Z # components for memory-leak triage. pprof is exposed on :6060 by the
2026-08-10T06:15:24.1199204Z # kind-ci profile (pprof.enabled=true). Best-effort: never fail the job.
2026-08-10T06:15:24.1199667Z mkdir -p pprof-dumps
2026-08-10T06:15:24.1200027Z for svc in router executor workflow; do
2026-08-10T06:15:24.1200696Z   pod=$(kubectl get pods -n fission -l svc=$svc -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
2026-08-10T06:15:24.1201425Z   [ -z "$pod" ] && { echo "no $svc pod found, skipping"; continue; }
2026-08-10T06:15:24.1202038Z   kubectl port-forward -n fission "pod/$pod" 6060:6060 >/dev/null 2>&1 &
2026-08-10T06:15:24.1202531Z   pf_pid=$!
2026-08-10T06:15:24.1203126Z   for i in $(seq 1 10); do curl -fsS http://127.0.0.1:6060/debug/pprof/ >/dev/null 2>&1 && break; sleep 1; done
2026-08-10T06:15:24.1204293Z   curl -fsS "http://127.0.0.1:6060/debug/pprof/heap" -o "pprof-dumps/${svc}-heap.pprof" || echo "heap capture failed for $svc"
2026-08-10T06:15:24.1205423Z   curl -fsS "http://127.0.0.1:6060/debug/pprof/goroutine?debug=1" -o "pprof-dumps/${svc}-goroutine.txt" || echo "goroutine capture failed for $svc"
2026-08-10T06:15:24.1206097Z   kill "$pf_pid" 2>/dev/null || true
2026-08-10T06:15:24.1206316Z done
2026-08-10T06:15:24.1206491Z ls -l pprof-dumps || true
