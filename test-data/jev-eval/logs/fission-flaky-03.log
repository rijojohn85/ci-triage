2026-08-10T06:15:27.8856306Z ##[group]Run # The self-healing forward loops (test-registry, loki) convert a
2026-08-10T06:15:27.8856754Z # The self-healing forward loops (test-registry, loki) convert a
2026-08-10T06:15:27.8857134Z # permanently-dead service into test-timeout-shaped failures; the
2026-08-10T06:15:27.8857500Z # repeating "unable to forward" lines naming the real cause live
2026-08-10T06:15:27.8857865Z # only in these runner-local files, which no artifact captures.
2026-08-10T06:15:27.8858218Z # (Router/mcp traffic goes through the in-process registry, whose
2026-08-10T06:15:27.8858541Z # dial errors surface directly in test output.)
2026-08-10T06:15:27.8858838Z for f in /tmp/pf-registry.log /tmp/pf-loki.log; do
2026-08-10T06:15:27.8859094Z   echo "===== $f ====="
2026-08-10T06:15:27.8859348Z   tail -n 100 "$f" 2>/dev/null || echo "(absent)"
2026-08-10T06:15:27.8859587Z done
2026-08-10T06:15:27.8903565Z shell: /usr/bin/bash -e {0}
2026-08-10T06:15:27.8904148Z env:
2026-08-10T06:15:27.8904325Z   HELM_VERSION: v4.2.3
