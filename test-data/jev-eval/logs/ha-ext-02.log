2026-09-23T11:06:38.8292082Z ##[start-action display=Refresh dynamic linker cache;id=python.__selfRepository.__run_2]
2026-09-23T11:06:38.8307830Z ##[group]Run # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-23T11:06:38.8308422Z # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-23T11:06:38.8308948Z # cache restore, so update-alternatives symlinks (eg the one libblas
2026-09-23T11:06:38.8309469Z # creates at /usr/lib/<multiarch>/libblas.so.3) are never produced.
2026-09-23T11:06:38.8315253Z # Add every /usr/lib/<multiarch> subdirectory that holds shared
2026-09-23T11:06:38.8315786Z # libraries to the ldconfig search path so the dynamic linker still
2026-09-23T11:06:38.8316281Z # finds them.  Use dpkg-architecture to derive the host's multiarch
2026-09-23T11:06:38.8316725Z # tuple so this works on non-x86_64 runners too.
2026-09-23T11:06:38.8317139Z multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
2026-09-23T11:06:38.8317600Z find "/usr/lib/${multiarch}" -mindepth 2 -maxdepth 2 \
2026-09-23T11:06:38.8317979Z   -name '*.so.*' -printf '%h\n' \
2026-09-23T11:06:38.8318286Z   | sort -u \
2026-09-23T11:06:38.8318641Z   | sudo tee /etc/ld.so.conf.d/zzz-cache-apt-extras.conf > /dev/null
2026-09-23T11:06:38.8319034Z sudo ldconfig
2026-09-23T11:06:38.8380636Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
