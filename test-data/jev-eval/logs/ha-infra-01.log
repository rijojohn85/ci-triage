2026-09-21T21:01:30.8923537Z ##[group]Run # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-21T21:01:30.8924127Z # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-21T21:01:30.8924630Z # cache restore, so update-alternatives symlinks (eg the one libblas
2026-09-21T21:01:30.8925116Z # creates at /usr/lib/<multiarch>/libblas.so.3) are never produced.
2026-09-21T21:01:30.8925573Z # Add every /usr/lib/<multiarch> subdirectory that holds shared
2026-09-21T21:01:30.8926027Z # libraries to the ldconfig search path so the dynamic linker still
2026-09-21T21:01:30.8926500Z # finds them.  Use dpkg-architecture to derive the host's multiarch
2026-09-21T21:01:30.8926933Z # tuple so this works on non-x86_64 runners too.
2026-09-21T21:01:30.8927332Z multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
2026-09-21T21:01:30.8927758Z find "/usr/lib/${multiarch}" -mindepth 2 -maxdepth 2 \
2026-09-21T21:01:30.8928143Z   -name '*.so.*' -printf '%h\n' \
2026-09-21T21:01:30.8928433Z   | sort -u \
2026-09-21T21:01:30.8928781Z   | sudo tee /etc/ld.so.conf.d/zzz-cache-apt-extras.conf > /dev/null
2026-09-21T21:01:30.8929155Z sudo ldconfig
2026-09-21T21:01:30.8966806Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
