2026-09-26T07:54:35.5687906Z ##[start-action display=Refresh dynamic linker cache;id=__self.__run_2]
2026-09-26T07:54:35.5788817Z ##[group]Run # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-26T07:54:35.5789273Z # awalsh128/cache-apt-pkgs-action does not run postinst scripts on
2026-09-26T07:54:35.5789676Z # cache restore, so update-alternatives symlinks (eg the one libblas
2026-09-26T07:54:35.5790055Z # creates at /usr/lib/<multiarch>/libblas.so.3) are never produced.
2026-09-26T07:54:35.5790435Z # Add every /usr/lib/<multiarch> subdirectory that holds shared
2026-09-26T07:54:35.5790803Z # libraries to the ldconfig search path so the dynamic linker still
2026-09-26T07:54:35.5791209Z # finds them.  Use dpkg-architecture to derive the host's multiarch
2026-09-26T07:54:35.5791599Z # tuple so this works on non-x86_64 runners too.
2026-09-26T07:54:35.5792057Z multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"
2026-09-26T07:54:35.5792394Z find "/usr/lib/${multiarch}" -mindepth 2 -maxdepth 2 \
2026-09-26T07:54:35.5792684Z   -name '*.so.*' -printf '%h\n' \
2026-09-26T07:54:35.5792926Z   | sort -u \
2026-09-26T07:54:35.5793212Z   | sudo tee /etc/ld.so.conf.d/zzz-cache-apt-extras.conf > /dev/null
2026-09-26T07:54:35.5793517Z sudo ldconfig
2026-09-26T07:54:35.5819764Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
