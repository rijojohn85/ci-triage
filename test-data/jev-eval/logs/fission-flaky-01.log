2026-09-15T12:35:28.6303757Z ##[group]Run # The self-healing forward loops (test-registry, loki) convert a
2026-09-15T12:35:28.6304430Z # The self-healing forward loops (test-registry, loki) convert a
2026-09-15T12:35:28.6305092Z # permanently-dead service into test-timeout-shaped failures; the
2026-09-15T12:35:28.6305605Z # repeating "unable to forward" lines naming the real cause live
2026-09-15T12:35:28.6306059Z # only in these runner-local files, which no artifact captures.
2026-09-15T12:35:28.6306854Z # (Router/mcp traffic goes through the in-process registry, whose
2026-09-15T12:35:28.6307308Z # dial errors surface directly in test output.)
2026-09-15T12:35:28.6307690Z for f in /tmp/pf-registry.log /tmp/pf-loki.log; do
2026-09-15T12:35:28.6308023Z   echo "===== $f ====="
2026-09-15T12:35:28.6308334Z   tail -n 100 "$f" 2>/dev/null || echo "(absent)"
2026-09-15T12:35:28.6308865Z done
