2026-09-15T12:08:06.9880573Z # kubectl patch takes no --all, so patch each Deployment, then wait
2026-09-15T12:08:06.9881115Z # for every rollout (patch-all-first so the rollouts run in parallel).
2026-09-15T12:08:06.9881592Z for d in $(kubectl -n fission get deploy -o name); do
2026-09-15T12:08:06.9881996Z   kubectl -n fission patch "$d" --type merge -p \
2026-09-15T12:08:06.9882513Z     '{"spec":{"template":{"spec":{"dnsConfig":{"options":[{"name":"single-request-reopen"}]}}}}}'
2026-09-15T12:08:06.9882977Z done
2026-09-15T12:08:06.9883255Z for d in $(kubectl -n fission get deploy -o name); do
2026-09-15T12:08:06.9883683Z   kubectl -n fission rollout status "$d" --timeout=5m
2026-09-15T12:08:06.9884029Z done
2026-09-15T12:08:06.9884372Z # deploy/mcp must exist and be ready (kind-ci enables mcp.enabled):
2026-09-15T12:08:06.9884851Z # the MCP integration test skips itself when the endpoint is
2026-09-15T12:08:06.9885318Z # unreachable, so without this explicit gate a profile regression
2026-09-15T12:08:06.9885808Z # would silently turn all MCP coverage into a green skip — the
2026-09-15T12:08:06.9886241Z # loop above only waits for deployments that exist.
2026-09-15T12:08:06.9886941Z kubectl -n fission rollout status deploy/mcp --timeout=3m
2026-09-15T12:08:06.9932245Z shell: /usr/bin/bash -e {0}
