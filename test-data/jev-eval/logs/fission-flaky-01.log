2026-09-15T12:11:35.8184245Z ##[group]Run # Pre-pull and kind-load every runtime/builder image referenced by
2026-09-15T12:11:35.8184988Z # Pre-pull and kind-load every runtime/builder image referenced by
2026-09-15T12:11:35.8185482Z # tests in this phase so the Kind nodes don't re-pull on first
2026-09-15T12:11:35.8185960Z # function invocation. Add new images to this list as more tests
2026-09-15T12:11:35.8186844Z # land. Set FOO_IMAGE="" in the env block above to skip an image.
2026-09-15T12:11:35.8187418Z # Pull/load run in parallel — sequential was ~50s, parallel ~15s.
2026-09-15T12:11:35.8188140Z load_image() {
2026-09-15T12:11:35.8188888Z   local img="$1"
2026-09-15T12:11:35.8189350Z   [ -z "$img" ] && return 0
2026-09-15T12:11:35.8189846Z   docker pull -q "$img" \
2026-09-15T12:11:35.8190487Z     && kind load docker-image "$img" --name "${KIND_CLUSTER_NAME}"
2026-09-15T12:11:35.8191180Z }
2026-09-15T12:11:35.8191543Z export -f load_image
2026-09-15T12:11:35.8192004Z export KIND_CLUSTER_NAME
2026-09-15T12:11:35.8192479Z pids=()
2026-09-15T12:11:35.8194550Z for img in "$NODE_RUNTIME_IMAGE" "$NODE_BUILDER_IMAGE" "$PYTHON_RUNTIME_IMAGE" "$PYTHON_BUILDER_IMAGE" "$GO_RUNTIME_IMAGE" "$GO_BUILDER_IMAGE" "$RUST_RUNTIME_IMAGE" "$RUST_BUILDER_IMAGE" "$JVM_RUNTIME_IMAGE" "$JVM_BUILDER_IMAGE" "$JVM_JERSEY_RUNTIME_IMAGE" "$JVM_JERSEY_BUILDER_IMAGE" "$TS_RUNTIME_IMAGE" "$CONTAINER_RUNTIME_IMAGE"; do
2026-09-15T12:11:35.8196969Z   load_image "$img" &
2026-09-15T12:11:35.8197393Z   pids+=($!)
2026-09-15T12:11:35.8197762Z done
2026-09-15T12:11:35.8198147Z for pid in "${pids[@]}"; do
2026-09-15T12:11:35.8198774Z   wait "$pid" || { echo "image preload failed (pid $pid)"; exit 1; }
2026-09-15T12:11:35.8199406Z done
2026-09-15T12:11:35.8199756Z 
2026-09-15T12:11:35.8200364Z # Build the Java fat jars for the jar-deploy subtests (TestJavaEnv/deploy_jar,
2026-09-15T12:11:35.8201383Z # TestJVMJerseyEnv/deploy_jar). The example poms depend on fission-java-core /
2026-09-15T12:11:35.8202421Z # fission-jvm-jersey, which are not on Maven Central — they live in the builder
2026-09-15T12:11:35.8203404Z # images' local .m2. So run `mvn package` *inside* the (already-pulled) builder
2026-09-15T12:11:35.8204402Z # image, which resolves them exactly as an in-cluster build does. Output goes to
2026-09-15T12:11:35.8205425Z # a dir outside the repo tree so it doesn't pollute the testdata embed or leave
2026-09-15T12:11:35.8206702Z # root-owned files in the checkout. Export the jar paths for the go test below.
2026-09-15T12:11:35.8207513Z build_jar() {
2026-09-15T12:11:35.8207948Z   local img="$1" src="$2" out="$3"
2026-09-15T12:11:35.8208607Z   # Empty image (var blanked to skip) → leave the jar absent; the
2026-09-15T12:11:35.8209409Z   # jar-deploy subtest then skips itself on the missing path.
2026-09-15T12:11:35.8210220Z   [ -z "$img" ] && { echo "skip jar build for $src (image unset)"; return 0; }
2026-09-15T12:11:35.8210952Z   docker run --rm --entrypoint /bin/bash \
2026-09-15T12:11:35.8211585Z     -v "$PWD/$src":/src:ro -v "$(dirname "$out")":/out \
2026-09-15T12:11:35.8212329Z     "$img" -c "mkdir -p /build && cp -a /src/. /build/ && cd /build \
2026-09-15T12:11:35.8213326Z       && mvn -q -B clean package && cp target/*with-dependencies.jar /out/$(basename "$out")"
2026-09-15T12:11:35.8214105Z }
2026-09-15T12:11:35.8214538Z JAR_DIR="${RUNNER_TEMP:-/tmp}/java-jars"
2026-09-15T12:11:35.8215082Z mkdir -p "$JAR_DIR"
2026-09-15T12:11:35.8215916Z build_jar "$JVM_BUILDER_IMAGE" test/integration/testdata/java/hello_world "$JAR_DIR/hello-world.jar"
2026-09-15T12:11:35.8217990Z build_jar "$JVM_JERSEY_BUILDER_IMAGE" test/integration/testdata/jvm_jersey/hello_world "$JAR_DIR/jersey-hello-world.jar"
2026-09-15T12:11:35.8219200Z export JAVA_HELLO_JAR_PATH="$JAR_DIR/hello-world.jar"
2026-09-15T12:11:35.8219980Z export JVM_JERSEY_JAR_PATH="$JAR_DIR/jersey-hello-world.jar"
2026-09-15T12:11:35.8220701Z echo "built jars: $(ls -l "$JAR_DIR")"
2026-09-15T12:11:35.8221201Z 
2026-09-15T12:11:35.8221684Z # No router/mcp port-forwards: the integration framework
2026-09-15T12:11:35.8222516Z # port-forwards in-process (go-portless registry — router.fission /
2026-09-15T12:11:35.8223341Z # router-internal.fission / mcp.fission resolved from
2026-09-15T12:11:35.8224433Z # FISSION_NAMESPACE), self-healing across pod restarts and blocking
2026-09-15T12:11:35.8225301Z # dials until the service is ready. Only services dialed by plain
2026-09-15T12:11:35.8226334Z # HTTP clients outside the framework still need a forward loop:
2026-09-15T12:11:35.8227844Z # OCI test registry (RFC-0001), deployed on the 1.32 + 1.36 legs.
2026-09-15T12:11:35.8228747Z # Tests push through the forward; the fetcher pulls the Service
2026-09-15T12:11:35.8229572Z # address. Env vars unset on other legs => tests skip. The 1.36 leg
2026-09-15T12:11:35.8230419Z # additionally runs the image-volume (Path B) tests: the kubelet
2026-09-15T12:11:35.8231270Z # pulls localhost:30500 via the registry's NodePort (containerd's
2026-09-15T12:11:35.8232057Z # built-in localhost HTTP exception — no node config needed).
2026-09-15T12:11:35.8232663Z PF_PID_REG=""
2026-09-15T12:11:35.8233187Z if [ "v1.32.11" = "v1.32.11" ] || [ "v1.32.11" = "v1.36.1" ]; then
2026-09-15T12:11:35.8234366Z   ( while true; do kubectl port-forward svc/test-registry 5001:5000 -n default || true; sleep 1; done ) >/tmp/pf-registry.log 2>&1 &
2026-09-15T12:11:35.8235388Z   PF_PID_REG=$!
2026-09-15T12:11:35.8235852Z   export FISSION_TEST_REGISTRY=127.0.0.1:5001
2026-09-15T12:11:35.8236987Z   export FISSION_TEST_REGISTRY_INCLUSTER=test-registry.default.svc.cluster.local:5000
2026-09-15T12:11:35.8237790Z fi
2026-09-15T12:11:35.8238162Z if [ "v1.32.11" = "v1.36.1" ]; then
2026-09-15T12:11:35.8238685Z   export FISSION_TEST_IMAGE_VOLUME=1
2026-09-15T12:11:35.8239297Z   export FISSION_TEST_REGISTRY_NODE=localhost:30500
2026-09-15T12:11:35.8239905Z   export FISSION_TEST_OCI_PRODUCER=1
2026-09-15T12:11:35.8240365Z fi
2026-09-15T12:11:35.8240851Z # OTel Collector + Loki (RFC-0016), deployed on the 1.34 leg. Forward
2026-09-15T12:11:35.8241659Z # Loki so the in-process `loki` logdb driver reaches it via LOKI_URL;
2026-09-15T12:11:35.8242529Z # FISSION_TEST_LOKI gates TestFunctionLogsLokiCorrelation (unset
2026-09-15T12:11:35.8243226Z # elsewhere => the test skips).
2026-09-15T12:11:35.8243558Z PF_PID_LOKI=""
2026-09-15T12:11:35.8243814Z if [ "v1.32.11" = "v1.34.8" ]; then
2026-09-15T12:11:35.8244422Z   ( while true; do kubectl port-forward svc/loki 3100:3100 -n fission-logging || true; sleep 1; done ) >/tmp/pf-loki.log 2>&1 &
2026-09-15T12:11:35.8244991Z   PF_PID_LOKI=$!
2026-09-15T12:11:35.8245323Z   export LOKI_URL=http://127.0.0.1:3100
2026-09-15T12:11:35.8245650Z   export FISSION_TEST_LOKI=1
2026-09-15T12:11:35.8245914Z fi
2026-09-15T12:11:35.8246207Z trap "kill $PF_PID_REG $PF_PID_LOKI 2>/dev/null || true" EXIT
2026-09-15T12:11:35.8246925Z 
2026-09-15T12:11:35.8247313Z # Export the master HMAC secret so the framework's RouterClient
2026-09-15T12:11:35.8247769Z # signs /fission-function/... requests against the internal
2026-09-15T12:11:35.8248229Z # listener. Empty when internalAuth is disabled — the framework
2026-09-15T12:11:35.8248948Z # falls back to unsigned and the verifier short-circuits.
2026-09-15T12:11:35.8249501Z if kubectl get secret fission-internal-auth -n "$FISSION_NAMESPACE" >/dev/null 2>&1; then
2026-09-15T12:11:35.8250133Z   export FISSION_INTERNAL_AUTH_SECRET=$(kubectl get secret fission-internal-auth \
2026-09-15T12:11:35.8250683Z     -n "$FISSION_NAMESPACE" -o jsonpath='{.data.secret}' | base64 -d)
2026-09-15T12:11:35.8251242Z   echo "exported FISSION_INTERNAL_AUTH_SECRET (${#FISSION_INTERNAL_AUTH_SECRET} bytes)"
2026-09-15T12:11:35.8251699Z else
2026-09-15T12:11:35.8252080Z   echo "fission-internal-auth Secret not present — running tests in unsigned mode"
2026-09-15T12:11:35.8252675Z fi
2026-09-15T12:11:35.8252877Z 
2026-09-15T12:11:35.8253197Z # No readiness poll: the framework's registry blocks each dial until
2026-09-15T12:11:35.8253706Z # the target service accepts, so the first test request self-waits.
2026-09-15T12:11:35.8254090Z 
2026-09-15T12:11:35.8254389Z # On the coverage leg, also instrument the test binary itself so the
2026-09-15T12:11:35.8254858Z # CLI + client-library code the suite drives in-process (via
2026-09-15T12:11:35.8255323Z # cmd/fission-cli/app.App) is captured. The test process writes
2026-09-15T12:11:35.8255805Z # binary-coverage data to covdata-cli/, merged with the pod data in
2026-09-15T12:11:35.8256251Z # the collect step. Other legs run uninstrumented.
2026-09-15T12:11:35.8256878Z COVER_FLAGS=()
2026-09-15T12:11:35.8257119Z COVER_ARGS=()
2026-09-15T12:11:35.8257382Z if [ "v1.32.11" = "v1.32.11" ]; then
2026-09-15T12:11:35.8257693Z   mkdir -p "$PWD/covdata-cli"
2026-09-15T12:11:35.8258070Z   COVER_FLAGS=(-cover -coverpkg=github.com/fission/fission/...)
2026-09-15T12:11:35.8258523Z   COVER_ARGS=(-args -test.gocoverdir="$PWD/covdata-cli")
2026-09-15T12:11:35.8258869Z fi
2026-09-15T12:11:35.8259207Z go test -tags=integration "${COVER_FLAGS[@]}" -timeout=35m -parallel 6 -v \
2026-09-15T12:11:35.8259704Z   ./test/integration/suites/common/... "${COVER_ARGS[@]}"
2026-09-15T12:11:35.8260053Z 
2026-09-15T12:11:35.8260366Z # Serial phase: tests that mutate cluster-wide control-plane state
2026-09-15T12:11:35.8260874Z # (e.g. restarting the executor to exercise AdoptExistingResources)
2026-09-15T12:11:35.8261369Z # and so cannot run alongside the parallel common suite. Runs after
2026-09-15T12:11:35.8261844Z # it, single-package (-p 1), reusing the HMAC secret established
2026-09-15T12:11:35.8262284Z # above. On the coverage leg the same -cover flags
2026-09-15T12:11:35.8262719Z # apply, so the in-process CLI coverage merges into covdata-cli and
2026-09-15T12:11:35.8263210Z # the executor pod's adopt-path coverage flushes to the node hostPath.
2026-09-15T12:11:35.8263707Z # -timeout is kept above the test's own 15m context deadline so the
2026-09-15T12:11:35.8264190Z # context fires first (clear failure) rather than the hard timeout.
2026-09-15T12:11:35.8264687Z go test -tags=integration "${COVER_FLAGS[@]}" -p 1 -timeout=25m -v \
2026-09-15T12:11:35.8265163Z   ./test/integration/suites/serial/... "${COVER_ARGS[@]}"
