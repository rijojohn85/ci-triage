2026-09-09T17:54:30.4870215Z ##[group]Run bail() {
2026-09-09T17:54:30.4870522Z bail() {
2026-09-09T17:54:30.4870807Z   printf '::error::install-action: %s\n' "$*"
2026-09-09T17:54:30.4871152Z   exit 1
2026-09-09T17:54:30.4871381Z }
2026-09-09T17:54:30.4871777Z # If /bin/sh is dash, environment variable containing % is not imported, but is fine
2026-09-09T17:54:30.4872363Z # because it also means that it will not be exposed to subprocess.
2026-09-09T17:54:30.4872860Z if /usr/bin/env | grep -Eq '^BASH_FUNC_'; then
2026-09-09T17:54:30.4873435Z   bail 'bash function injection via BASH_FUNC_ environment variable is not allowed for security reasons'
2026-09-09T17:54:30.4873896Z fi
2026-09-09T17:54:30.4874171Z if ! command -v bash >/dev/null; then
2026-09-09T17:54:30.4874516Z   if grep -Eq '^ID=alpine' /etc/os-release; then
2026-09-09T17:54:30.4874973Z     printf '::group::Install packages required for install-action (bash)\n'
2026-09-09T17:54:30.4875627Z     # NB: sync with apk_install in main.sh
2026-09-09T17:54:30.4875962Z     if command -v sudo >/dev/null; then
2026-09-09T17:54:30.4876302Z       sudo apk --no-cache add bash
2026-09-09T17:54:30.4876632Z     elif command -v doas >/dev/null; then
2026-09-09T17:54:30.4876939Z       doas apk --no-cache add bash
2026-09-09T17:54:30.4877274Z     else
2026-09-09T17:54:30.4877532Z       apk --no-cache add bash
2026-09-09T17:54:30.4877965Z     fi
2026-09-09T17:54:30.4878232Z     printf '::endgroup::\n'
2026-09-09T17:54:30.4878503Z   else
2026-09-09T17:54:30.4878825Z     bail 'this action requires bash'
2026-09-09T17:54:30.4879127Z   fi
2026-09-09T17:54:30.4879357Z fi
2026-09-09T17:54:30.4879673Z bash --noprofile --norc "${GITHUB_ACTION_PATH:?}/main.sh"
2026-09-09T17:54:30.4880795Z shell: /usr/bin/env -u ENV -u BASH_ENV -u CDPATH -u SHELLOPTS -u BASHOPTS /bin/sh -eu {0}
