{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "description": "Spoke errors return A2A `FAILED` carrying exactly this shape.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "ApprovalPayload": {
      "additionalProperties": false,
      "description": "The human's `triage approve|reject` decision, one A2A message (AD-14).\n\nEffect contract of `class_override`: replaces only the low-confidence and\nunknown-class cutoff checks; `confidence` itself stays min(...) (AD-9).",
      "properties": {
        "class_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "note"
      ],
      "title": "ApprovalPayload",
      "type": "object"
    },
    "CandidateSuspect": {
      "additionalProperties": false,
      "description": "A deterministically ranked candidate; the Analyzer picks from these (AD-24).",
      "properties": {
        "changed_files": {
          "items": {
            "type": "string"
          },
          "title": "Changed Files",
          "type": "array"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "rank",
        "changed_files"
      ],
      "title": "CandidateSuspect",
      "type": "object"
    },
    "Cap": {
      "additionalProperties": false,
      "description": "One confidence cap: a reason plus its citations; nothing may raise it\n(AD-9). Frozen with a tuple of citations so a built `Cap` can never be\nmutated to raise `ClassConfidence.confidence` back up.",
      "properties": {
        "citations": {
          "items": {
            "discriminator": {
              "mapping": {
                "commit": "#/$defs/CommitCitation",
                "history_row": "#/$defs/HistoryRowCitation",
                "jev_signal": "#/$defs/JevSignalCitation",
                "log_line": "#/$defs/LogLineCitation",
                "metric": "#/$defs/MetricCitation"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LogLineCitation"
              },
              {
                "$ref": "#/$defs/CommitCitation"
              },
              {
                "$ref": "#/$defs/MetricCitation"
              },
              {
                "$ref": "#/$defs/HistoryRowCitation"
              },
              {
                "$ref": "#/$defs/JevSignalCitation"
              }
            ]
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "reason",
        "citations"
      ],
      "title": "Cap",
      "type": "object"
    },
    "CommitCitation": {
      "additionalProperties": false,
      "description": "`commit` locator: a full `Sha40` SHA within `last_green..HEAD` (AD-7).",
      "properties": {
        "kind": {
          "const": "commit",
          "default": "commit",
          "title": "Kind",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "sha"
      ],
      "title": "CommitCitation",
      "type": "object"
    },
    "CommitRecord": {
      "additionalProperties": false,
      "description": "A full-SHA commit of the `last_green..HEAD` range (AD-24).",
      "properties": {
        "author_login": {
          "minLength": 1,
          "title": "Author Login",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "message",
        "author_login"
      ],
      "title": "CommitRecord",
      "type": "object"
    },
    "DiffFile": {
      "additionalProperties": false,
      "description": "One file of the proposed diff (AD-6).",
      "properties": {
        "new_content": {
          "title": "New Content",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/DiffOperation"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "op",
        "new_content"
      ],
      "title": "DiffFile",
      "type": "object"
    },
    "DiffOperation": {
      "description": "Proposed-diff file operation `add | modify | delete` (AD-6).",
      "enum": [
        "add",
        "modify",
        "delete"
      ],
      "title": "DiffOperation",
      "type": "string"
    },
    "DistilledLogLine": {
      "additionalProperties": false,
      "description": "One numbered line of the distilled log (AD-20, AD-24).",
      "properties": {
        "line_number": {
          "exclusiveMinimum": 0,
          "title": "Line Number",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "line_number",
        "text"
      ],
      "title": "DistilledLogLine",
      "type": "object"
    },
    "Escalation": {
      "additionalProperties": false,
      "description": "`AWAITING_APPROVAL` message to the human (AD-1, AD-14).",
      "properties": {
        "proposal_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Step Id"
        },
        "reason": {
          "$ref": "#/$defs/EscalationReason"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Escalation",
      "type": "object"
    },
    "EscalationReason": {
      "description": "`AWAITING_APPROVAL` escalation reasons, the exact AD-1 set.",
      "enum": [
        "low_confidence",
        "unknown_class",
        "no_route",
        "validation_failed",
        "review_rejected",
        "gate_blocked"
      ],
      "title": "EscalationReason",
      "type": "string"
    },
    "EvidencePack": {
      "additionalProperties": false,
      "description": "The deterministic single evidence source for every agent of the run (AD-24).",
      "properties": {
        "candidate_suspects": {
          "items": {
            "$ref": "#/$defs/CandidateSuspect"
          },
          "title": "Candidate Suspects",
          "type": "array"
        },
        "commits": {
          "items": {
            "$ref": "#/$defs/CommitRecord"
          },
          "title": "Commits",
          "type": "array"
        },
        "distilled_log": {
          "items": {
            "$ref": "#/$defs/DistilledLogLine"
          },
          "minItems": 1,
          "title": "Distilled Log",
          "type": "array"
        },
        "history_rows": {
          "items": {
            "$ref": "#/$defs/HistoryRow"
          },
          "title": "History Rows",
          "type": "array"
        },
        "last_green": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Last Green",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "last_green",
        "distilled_log",
        "commits",
        "candidate_suspects",
        "history_rows",
        "metrics"
      ],
      "title": "EvidencePack",
      "type": "object"
    },
    "FailureClass": {
      "description": "Failure class enum `code | flaky | infra | external | unknown` (AD-11).",
      "enum": [
        "code",
        "flaky",
        "infra",
        "external",
        "unknown"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "HistoryRow": {
      "additionalProperties": false,
      "description": "Structured-only history row, cited by `row_id` (AD-15).",
      "properties": {
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "fingerprint": {
          "minLength": 1,
          "title": "Fingerprint",
          "type": "string"
        },
        "row_id": {
          "minLength": 1,
          "title": "Row Id",
          "type": "string"
        },
        "test_id": {
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "fingerprint",
        "test_id",
        "error_type"
      ],
      "title": "HistoryRow",
      "type": "object"
    },
    "HistoryRowCitation": {
      "additionalProperties": false,
      "description": "`history_row` locator: a `row_id` served in the evidence pack (AD-7, AD-15).",
      "properties": {
        "kind": {
          "const": "history_row",
          "default": "history_row",
          "title": "Kind",
          "type": "string"
        },
        "row_id": {
          "minLength": 1,
          "title": "Row Id",
          "type": "string"
        }
      },
      "required": [
        "row_id"
      ],
      "title": "HistoryRowCitation",
      "type": "object"
    },
    "JevChoice": {
      "additionalProperties": false,
      "description": "The 5-class `Choice` answer: `confidence_jev`'s source (AD-9, AD-11).\n\nFrozen once built (AD-9): nothing downstream may mutate the Jev number.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/FailureClass"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/FailureClass"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "answer",
        "confidence",
        "probabilities"
      ],
      "title": "JevChoice",
      "type": "object"
    },
    "JevClassification": {
      "additionalProperties": false,
      "description": "One Jev `system_one` call: the class choice plus the injection screen\n(spine: one call carries both the 5-class `Choice` and the `Noul`\npre-screen).",
      "properties": {
        "choice": {
          "$ref": "#/$defs/JevChoice"
        },
        "injection_screen": {
          "$ref": "#/$defs/JevInjectionScreen"
        }
      },
      "required": [
        "choice",
        "injection_screen"
      ],
      "title": "JevClassification",
      "type": "object"
    },
    "JevInjectionScreen": {
      "additionalProperties": false,
      "description": "The injection pre-screen `Noul` answer (spine \"One Jev call\" rule):\na probability, not a boolean \u2014 `guardrails.confidence` turns it into a\ncited cap above its cutoff.",
      "properties": {
        "noul": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Noul",
          "type": "number"
        }
      },
      "required": [
        "noul"
      ],
      "title": "JevInjectionScreen",
      "type": "object"
    },
    "JevResult": {
      "additionalProperties": false,
      "description": "What the Jev agent serves for one `classify-failure` call (story 3.1).\n\nThe classification plus the provider-reported usage (AD-18): the\norchestrator/harness owns the accounting, so the agent only reports what\nthe provider reported \u2014 unreported counters stay NULL, never 0.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/JevClassification"
        },
        "usage": {
          "$ref": "#/$defs/ModelUsage"
        }
      },
      "required": [
        "classification",
        "usage"
      ],
      "title": "JevResult",
      "type": "object"
    },
    "JevSignalCitation": {
      "additionalProperties": false,
      "description": "`jev_signal` locator: the answer key of this run's Jev call (AD-7, AD-11).",
      "properties": {
        "answer": {
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "kind": {
          "const": "jev_signal",
          "default": "jev_signal",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "answer"
      ],
      "title": "JevSignalCitation",
      "type": "object"
    },
    "LogLineCitation": {
      "additionalProperties": false,
      "description": "`log_line` locator: a line number in the numbered distilled log (AD-7).",
      "properties": {
        "kind": {
          "const": "log_line",
          "default": "log_line",
          "title": "Kind",
          "type": "string"
        },
        "log_line": {
          "minimum": 1,
          "title": "Log Line",
          "type": "integer"
        }
      },
      "required": [
        "log_line"
      ],
      "title": "LogLineCitation",
      "type": "object"
    },
    "MetricCitation": {
      "additionalProperties": false,
      "description": "`metric` locator: a key of the collected runner metrics (AD-7).",
      "properties": {
        "kind": {
          "const": "metric",
          "default": "metric",
          "title": "Kind",
          "type": "string"
        },
        "metric_key": {
          "minLength": 1,
          "title": "Metric Key",
          "type": "string"
        }
      },
      "required": [
        "metric_key"
      ],
      "title": "MetricCitation",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "description": "What one model call consumed: the model and its token counters.\n\nEvery counter is nullable; NULL means \"provider did not report\" (AD-18),\nso downstream costing (6.2) can keep incomplete totals visibly\nincomplete instead of silently summing zeros.",
      "properties": {
        "cache_creation_input_tokens_1h": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Creation Input Tokens 1H"
        },
        "cache_creation_input_tokens_5m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Creation Input Tokens 5M"
        },
        "cache_read_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Input Tokens"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        }
      },
      "required": [
        "model"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "ProposedDiff": {
      "additionalProperties": false,
      "description": "The Proposer's diff: `base_sha` and its files (AD-6).",
      "properties": {
        "base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/DiffFile"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "base_sha",
        "files"
      ],
      "title": "ProposedDiff",
      "type": "object"
    },
    "Quarantine": {
      "additionalProperties": false,
      "description": "Quarantine recommendation stays out of `proposed_diff` (AD-21).",
      "properties": {
        "citations": {
          "items": {
            "discriminator": {
              "mapping": {
                "commit": "#/$defs/CommitCitation",
                "history_row": "#/$defs/HistoryRowCitation",
                "jev_signal": "#/$defs/JevSignalCitation",
                "log_line": "#/$defs/LogLineCitation",
                "metric": "#/$defs/MetricCitation"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LogLineCitation"
              },
              {
                "$ref": "#/$defs/CommitCitation"
              },
              {
                "$ref": "#/$defs/MetricCitation"
              },
              {
                "$ref": "#/$defs/HistoryRowCitation"
              },
              {
                "$ref": "#/$defs/JevSignalCitation"
              }
            ]
          },
          "title": "Citations",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "test_id": {
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "reason",
        "citations"
      ],
      "title": "Quarantine",
      "type": "object"
    },
    "RiskTier": {
      "description": "Risk gate outcome `normal | blocked | not_gated` (AD-6, AD-13).",
      "enum": [
        "normal",
        "blocked",
        "not_gated"
      ],
      "title": "RiskTier",
      "type": "string"
    },
    "Suspect": {
      "additionalProperties": false,
      "description": "Blame needs a commit citation plus a log line (AD-27) and a rank (AD-24).",
      "properties": {
        "author_login": {
          "minLength": 1,
          "title": "Author Login",
          "type": "string"
        },
        "citations": {
          "items": {
            "discriminator": {
              "mapping": {
                "commit": "#/$defs/CommitCitation",
                "history_row": "#/$defs/HistoryRowCitation",
                "jev_signal": "#/$defs/JevSignalCitation",
                "log_line": "#/$defs/LogLineCitation",
                "metric": "#/$defs/MetricCitation"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LogLineCitation"
              },
              {
                "$ref": "#/$defs/CommitCitation"
              },
              {
                "$ref": "#/$defs/MetricCitation"
              },
              {
                "$ref": "#/$defs/HistoryRowCitation"
              },
              {
                "$ref": "#/$defs/JevSignalCitation"
              }
            ]
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "author_login",
        "rank",
        "citations"
      ],
      "title": "Suspect",
      "type": "object"
    },
    "TerminalState": {
      "description": "Terminal `triage_run` outcome, per the AD-4 projection table.",
      "enum": [
        "pr_opened",
        "report_sent",
        "input_required",
        "rejected_by_human",
        "failed"
      ],
      "title": "TerminalState",
      "type": "string"
    },
    "TriageVerdict": {
      "additionalProperties": false,
      "description": "The one verdict every consumer reads (AD-6, AD-9).\n\nThe payload spelling is `class`; `populate_by_name` + `serialize_by_alias`\nkeep the dump \u2192 revalidate round trip byte-faithful.",
      "properties": {
        "caps": {
          "items": {
            "$ref": "#/$defs/Cap"
          },
          "title": "Caps",
          "type": "array"
        },
        "citations": {
          "items": {
            "discriminator": {
              "mapping": {
                "commit": "#/$defs/CommitCitation",
                "history_row": "#/$defs/HistoryRowCitation",
                "jev_signal": "#/$defs/JevSignalCitation",
                "log_line": "#/$defs/LogLineCitation",
                "metric": "#/$defs/MetricCitation"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LogLineCitation"
              },
              {
                "$ref": "#/$defs/CommitCitation"
              },
              {
                "$ref": "#/$defs/MetricCitation"
              },
              {
                "$ref": "#/$defs/HistoryRowCitation"
              },
              {
                "$ref": "#/$defs/JevSignalCitation"
              }
            ]
          },
          "title": "Citations",
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/FailureClass"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_jev": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Jev",
          "type": "number"
        },
        "proposed_diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedDiff"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quarantine": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quarantine"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk_tier": {
          "$ref": "#/$defs/RiskTier"
        },
        "suspects": {
          "items": {
            "$ref": "#/$defs/Suspect"
          },
          "title": "Suspects",
          "type": "array"
        },
        "terminal_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "class",
        "confidence",
        "confidence_jev",
        "caps",
        "suspects",
        "citations",
        "risk_tier"
      ],
      "title": "TriageVerdict",
      "type": "object"
    }
  },
  "additionalProperties": false,
